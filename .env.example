# Copy to .env and fill in what you need. Loaded from the config root, so
# `jobsearch --root DIR` picks up DIR/.env. .env itself is gitignored.

# Required only for `jobsearch evaluate`. Get one at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Scoring defaults to claude-haiku-4-5: it's a bulk classifier
# run over every candidate, and the judgement it makes is well within the
# small model. Point it at claude-sonnet-5 or claude-opus-5 for a run where
# you want a stronger read on a shortlist.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: override where the SQLite database lives (default
# data/seen_jobs.sqlite3 under the config root).
# DB_PATH=/absolute/path/to/seen_jobs.sqlite3

# Required only if you keep an Adzuna entry enabled in aggregators.yaml.
# Free signup at https://developer.adzuna.com. The Hacker News and
# Y Combinator sources need no credentials at all.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
